<div class="sence-connector-block-container p-2">
    <!-- Header Institucional Keystone Advisors con Logo Oficial -->
    <div class="text-center mb-3 pb-2 border-bottom">
        <a href="https://www.keystoneadvisors.cl" target="_blank" rel="noopener" class="d-inline-block">
            <img src="{{keystone_logo_url}}" alt="Keystone Advisors" style="max-height: 42px; width: auto; object-fit: contain;">
        </a>
        <div class="mt-1">
            <span class="badge bg-success badge-success text-white" style="font-size: 0.70rem; padding: 2px 6px;">
                <i class="fa fa-certificate me-1 mr-1"></i> Conector Oficial Gratuito
            </span>
        </div>
    </div>

    {{#is_active}}
        <!-- Badge de Estado SENCE Activo con Pulso -->
        <div class="alert alert-success d-flex align-items-center mb-2 p-2 shadow-sm border-0" role="alert" style="background-color: #eafaf1; border-left: 4px solid #28a745 !important;">
            <div class="me-2 mr-2 d-flex align-items-center">
                <span class="sence-pulse-dot" id="sence-status-dot"></span>
            </div>
            <div style="line-height: 1.25;">
                <div class="d-flex align-items-center justify-content-between">
                    <strong class="text-success" style="font-size: 0.85rem;" id="sence-status-text">Sesión SENCE Activa</strong>
                    <span class="badge bg-success badge-success text-white ms-2" id="sence-activity-badge" style="font-size: 0.65rem;">En Actividad</span>
                </div>
                <small class="text-muted" style="font-size: 0.75rem;">RUN: {{run_student}}</small>
            </div>
        </div>

        <!-- Cronómetro y Datos de la Sesión en Vivo con Detección de Actividad Real -->
        <div class="card border-0 mb-3 text-white shadow-sm" style="background: linear-gradient(135deg, #1b4b5e 0%, #0d2833 100%); border-radius: 8px;">
            <div class="card-body p-2 text-center">
                <div class="small text-uppercase opacity-75 mb-1 d-flex justify-content-between px-2" style="font-size: 0.68rem; letter-spacing: 0.5px;">
                    <span>Tiempo Efectivo Hoy</span>
                    <span id="sence-idle-timer" class="text-warning opacity-75"></span>
                </div>
                <div class="h3 font-weight-bold fw-bold mb-1" id="sence-live-timer" style="letter-spacing: 1px; color: #5cf2bd; font-family: monospace;">
                    {{session_effective_time_str}}
                </div>
                <div class="small opacity-75" style="font-size: 0.70rem;">
                    {{#user_group_name}}
                        <i class="fa fa-users me-1 mr-1"></i> {{user_group_name}}
                    {{/user_group_name}}
                    {{^user_group_name}}
                        <i class="fa fa-tag me-1 mr-1"></i> Acción: {{codigo_curso}}
                    {{/user_group_name}}
                </div>
            </div>
        </div>

        <!-- Alerta de Inactividad (Oculta por defecto) -->
        <div id="sence-idle-alert" class="alert alert-warning py-1 px-2 mb-2 small text-center d-none" style="font-size: 0.75rem; border-radius: 6px;">
            <i class="fa fa-pause-circle me-1 mr-1"></i> Cronómetro en pausa por inactividad. Mueve el cursor para reanudar.
        </div>

        <!-- Botón de Cierre Seguro SENCE -->
        <form action="{{rce_cerrar_url}}" method="POST" class="mb-3">
            <input type="hidden" name="RutOtec" value="{{rut_otec}}">
            <input type="hidden" name="Token" value="{{token}}">
            <input type="hidden" name="CodSence" value="{{cod_sence}}">
            <input type="hidden" name="CodigoCurso" value="{{codigo_curso}}">
            <input type="hidden" name="IdSesionAlumno" value="{{id_sesion_alumno}}">
            <input type="hidden" name="IdSesionSence" value="{{id_sesion_sence}}">
            <input type="hidden" name="UrlRetoma" value="{{url_retoma}}">
            <input type="hidden" name="UrlError" value="{{url_error}}">
            <button type="submit" class="btn btn-outline-danger btn-sm w-100 py-1 font-weight-bold" style="font-size: 0.8rem;">
                <i class="fa fa-sign-out fa-fw me-1 mr-1"></i> Pausar / Cerrar Asistencia SENCE
            </button>
        </form>
    {{/is_active}}

    {{^is_active}}
        <div class="alert alert-warning mb-3 p-2 small" role="alert">
            <i class="fa fa-exclamation-triangle me-1 mr-1 text-warning"></i>
            Debes validar tu asistencia en SENCE para registrar tus horas del curso.
        </div>

        <form action="{{rce_iniciar_url}}" method="POST" class="mb-3">
            <input type="hidden" name="RutOtec" value="{{rut_otec}}">
            <input type="hidden" name="Token" value="{{token}}">
            <input type="hidden" name="CodSence" value="{{cod_sence}}">
            <input type="hidden" name="CodigoCurso" value="{{codigo_curso}}">
            <input type="hidden" name="LineaCapacitacion" value="{{linea_capacitacion}}">
            <input type="hidden" name="RunAlumno" value="{{run_student}}">
            <input type="hidden" name="IdSesionAlumno" value="{{id_sesion_alumno}}">
            <input type="hidden" name="UrlRetoma" value="{{url_retoma}}">
            <input type="hidden" name="UrlError" value="{{url_error}}">
            <button type="submit" class="btn btn-primary btn-sm w-100 py-2 shadow-sm font-weight-bold" style="background-color: #225268; border-color: #225268;">
                <i class="fa fa-id-card fa-fw me-1 mr-1"></i> Iniciar Asistencia ClaveÚnica
            </button>
        </form>
    {{/is_active}}

    <!-- DASHBOARD DE PROGRESO Y DESEMPEÑO DEL ALUMNO -->
    <div class="student-sence-metrics card bg-light border-0 p-2 mb-3">
        <div class="d-flex justify-content-between align-items-center mb-2 pb-1 border-bottom">
            <span class="small font-weight-bold fw-bold text-dark" style="font-size: 0.78rem;">
                <i class="fa fa-line-chart me-1 mr-1 text-primary"></i> Mi Avance & Desempeño
            </span>
            <span class="badge {{#is_attendance_approved}}badge-success bg-success{{/is_attendance_approved}}{{^is_attendance_approved}}badge-warning bg-warning text-dark{{/is_attendance_approved}}" style="font-size: 0.65rem;">
                {{#is_attendance_approved}}SENCE OK (≥75%){{/is_attendance_approved}}
                {{^is_attendance_approved}}En Progreso (<75%){{/is_attendance_approved}}
            </span>
        </div>

        <!-- Métrica 1: Asistencia SENCE Efectiva -->
        <div class="mb-2">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="small text-muted" style="font-size: 0.73rem;">Asistencia SENCE (Efectiva):</span>
                <span class="badge badge-info bg-info text-white" id="sence-progress-badge" style="font-size: 0.72rem;">{{hours_connected}}h / {{hours_required}}h ({{attendance_percent}}%)</span>
            </div>
            <div class="progress" style="height: 6px;">
                <div class="progress-bar {{#is_attendance_approved}}bg-success{{/is_attendance_approved}}{{^is_attendance_approved}}bg-info{{/is_attendance_approved}}" id="sence-progress-bar" role="progressbar" style="width: {{attendance_percent}}%;" aria-valuenow="{{attendance_percent}}" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
        </div>

        <!-- Métrica 2: Progreso de Contenidos del Curso -->
        <div class="mb-2">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="small text-muted" style="font-size: 0.73rem;">Contenidos Completados:</span>
                <span class="small font-weight-bold fw-bold text-dark" style="font-size: 0.72rem;">{{course_progress}}%</span>
            </div>
            <div class="progress" style="height: 6px;">
                <div class="progress-bar bg-primary" role="progressbar" style="width: {{course_progress}}%; background-color: #225268 !important;" aria-valuenow="{{course_progress}}" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
        </div>

        <!-- Métrica 3: Calificación / Nota Actual -->
        <div class="d-flex justify-content-between align-items-center pt-1 border-top">
            <span class="small text-muted" style="font-size: 0.73rem;">
                <i class="fa fa-graduation-cap me-1 mr-1"></i> Calificación Actual:
            </span>
            <div>
                {{#has_grade}}
                    <span class="badge {{#is_grade_passing}}badge-success bg-success{{/is_grade_passing}}{{^is_grade_passing}}badge-danger bg-danger{{/is_grade_passing}} font-weight-bold" style="font-size: 0.75rem;">
                        {{grade_display}}
                    </span>
                {{/has_grade}}
                {{^has_grade}}
                    <span class="badge badge-secondary bg-secondary text-white" style="font-size: 0.70rem;">Sin notas aún</span>
                {{/has_grade}}
            </div>
        </div>
    </div>

    <!-- Opciones de Profesor / Administrador -->
    {{#is_teacher}}
        <hr class="my-2">
        <div class="d-grid gap-1">
            <a href="{{upload_students_url}}" class="btn btn-primary btn-sm w-100 mb-1 font-weight-bold shadow-sm" style="background-color: #1a4253; border-color: #1a4253; font-size: 0.80rem;">
                <i class="fa fa-user-plus fa-fw me-1 mr-1"></i> Carga Rápida Alumnos SENCE
            </a>
            <a href="{{report_url}}" class="btn btn-outline-dark btn-sm w-100 mb-1 font-weight-bold" style="font-size: 0.78rem;">
                <i class="fa fa-university fa-fw me-1 mr-1"></i> Centro de Informes y Auditoría SENCE
            </a>
            <a href="{{settings_url}}" class="btn btn-outline-secondary btn-sm w-100" style="font-size: 0.78rem;">
                <i class="fa fa-cog fa-fw me-1 mr-1"></i> Ajustes Curso SENCE
            </a>
        </div>
    {{/is_teacher}}

    <!-- Card Comercial: Solicitar Mejoras y Desarrollos a Medida -->
    <div class="card border-0 mt-3 shadow-sm text-center" style="background: linear-gradient(135deg, #f0f7fa 0%, #e2eef3 100%); border-radius: 8px; border: 1px solid #c8dfe8 !important;">
        <div class="card-body p-2">
            <div class="d-flex align-items-center justify-content-center mb-1">
                <i class="fa fa-lightbulb-o text-warning fa-lg me-1 mr-1"></i>
                <strong style="color: #1a4253; font-size: 0.78rem;">¿Necesitas mejoras para tu OTEC?</strong>
            </div>
            <p class="mb-2 text-muted" style="font-size: 0.71rem; line-height: 1.3;">
                Cotiza desarrollos a medida, reportes personalizados o nuevas funcionalidades integradas.
            </p>
            <a href="mailto:contacto@keystoneadvisors.cl?subject=Solicitud%20de%20Mejoras%20Plugin%20Moodle%20SENCE%20-%20Keystone%20Advisors&body=Hola%20equipo%20Keystone%20Advisors,%0A%0AQuisi%C3%A9ramos%20solicitar%20una%20cotizaci%C3%B3n%20para%20la%20siguiente%20mejora%20en%20nuestra%20plataforma%20Moodle%20SENCE:%0A%0A-%20Nombre%20OTEC:%20%0A-%20Contacto:%20%0A-%20Descripci%C3%B3n%20de%20la%20mejora%20requerida:%20%0A%0ASaludos%20cordiales." 
               class="btn btn-sm btn-outline-primary w-100 font-weight-bold" 
               style="font-size: 0.74rem; color: #1a4253; border-color: #1a4253; background-color: #ffffff;">
                <i class="fa fa-envelope-o me-1 mr-1"></i> Solicitar Mejora / Cotizar
            </a>
            <div class="mt-1" style="font-size: 0.65rem; color: #64748b;">
                <a href="mailto:contacto@keystoneadvisors.cl" style="color: #1a4253; text-decoration: none;">contacto@keystoneadvisors.cl</a>
            </div>
        </div>
    </div>

    <!-- Footer institucional Keystone Advisors -->
    <div class="text-center mt-3 pt-2 border-top" style="font-size: 0.68rem; line-height: 1.2; color: #6c757d;">
        Desarrollado y mantenido por<br>
        <a href="https://www.keystoneadvisors.cl" target="_blank" rel="noopener" class="fw-bold font-weight-bold text-decoration-none" style="color: #225268;">
            Keystone Advisors
        </a><br>
        Av. Apoquindo 6410, Of. 605, Las Condes
    </div>
</div>

<style>
.sence-pulse-dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    background-color: #28a745;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(40, 167, 69, 0.7);
    animation: sencePulse 1.8s infinite cubic-bezier(0.66, 0, 0, 1);
}

.sence-pulse-dot.paused {
    background-color: #ffc107 !important;
    animation: none !important;
    box-shadow: none !important;
}

@keyframes sencePulse {
    0% {
        transform: scale(0.95);
        box-shadow: 0 0 0 0 rgba(40, 167, 69, 0.7);
    }
    70% {
        transform: scale(1.1);
        box-shadow: 0 0 0 8px rgba(40, 167, 69, 0);
    }
    100% {
        transform: scale(0.95);
        box-shadow: 0 0 0 0 rgba(40, 167, 69, 0);
    }
}
</style>

{{#is_active}}
<script>
(function() {
    var effectiveSeconds = {{session_effective_seconds}};
    var courseId = {{courseid}};
    var sesskey = '{{sesskey}}';
    var pingUrl = '{{ping_url}}';
    
    var lastInteraction = Date.now();
    var isUserActive = true;
    var idleThresholdMs = 180000; // 3 minutos de inactividad para pausar cronometro
    
    var timerEl = document.getElementById('sence-live-timer');
    var dotEl = document.getElementById('sence-status-dot');
    var badgeEl = document.getElementById('sence-activity-badge');
    var alertEl = document.getElementById('sence-idle-alert');
    
    function pad(n) { return (n < 10 ? '0' : '') + n; }

    function renderTime() {
        var h = Math.floor(effectiveSeconds / 3600);
        var m = Math.floor((effectiveSeconds % 3600) / 60);
        var s = effectiveSeconds % 60;
        if (timerEl) {
            timerEl.textContent = pad(h) + ':' + pad(m) + ':' + pad(s);
        }
    }

    // Registrar interacciones del usuario
    function markActive() {
        lastInteraction = Date.now();
        if (!isUserActive) {
            isUserActive = true;
            if (dotEl) dotEl.classList.remove('paused');
            if (badgeEl) {
                badgeEl.className = 'badge bg-success badge-success text-white ms-2';
                badgeEl.textContent = 'En Actividad';
            }
            if (alertEl) alertEl.classList.add('d-none');
        }
    }

    ['mousemove', 'mousedown', 'keydown', 'scroll', 'touchstart', 'click'].forEach(function(evt) {
        window.addEventListener(evt, markActive, { passive: true });
    });

    // Revisar estado y avanzar segundo a segundo solo si hay actividad real
    setInterval(function() {
        var elapsedSinceAction = Date.now() - lastInteraction;
        if (elapsedSinceAction > idleThresholdMs) {
            if (isUserActive) {
                isUserActive = false;
                if (dotEl) dotEl.classList.add('paused');
                if (badgeEl) {
                    badgeEl.className = 'badge bg-warning badge-warning text-dark ms-2';
                    badgeEl.textContent = 'En Pausa';
                }
                if (alertEl) alertEl.classList.remove('d-none');
            }
        } else {
            // Usuario activo: sumamos un segundo efectivo
            effectiveSeconds++;
            renderTime();
        }
    }, 1000);

    // Heartbeat / Ping al servidor cada 30 segundos
    setInterval(function() {
        if (!navigator.onLine) return;
        var postData = new URLSearchParams();
        postData.append('courseid', courseId);
        postData.append('sesskey', sesskey);
        postData.append('active', isUserActive ? 1 : 0);

        fetch(pingUrl, {
            method: 'POST',
            body: postData,
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data.status === 'success' && data.session_effective_seconds !== undefined) {
                // Sincronizar con el cálculo del servidor
                effectiveSeconds = data.session_effective_seconds;
            } else if (data.status === 'timeout_closed') {
                window.location.reload();
            }
        })
        .catch(function(e) {
            // Ignorar errores transitorios de red
        });
    }, 30000);

    renderTime();
})();
</script>
{{/is_active}}
