<div class="sence-connector-block-container p-2">
    <!-- Badge de Plugin Gratuito Oficial -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="badge bg-success badge-success text-white" style="font-size: 0.72rem; padding: 3px 6px;">
            <i class="fa fa-certificate me-1 mr-1"></i> Plugin Oficial Gratuito
        </span>
        <a href="https://www.keystoneadvisors.cl" target="_blank" rel="noopener" class="small text-muted text-decoration-none" style="font-size: 0.72rem;">
            Keystone Advisors
        </a>
    </div>

    {{#is_active}}
        <div class="alert alert-success d-flex align-items-center mb-3 p-2" role="alert">
            <i class="fa fa-check-circle fa-lg me-2 mr-2 text-success"></i>
            <div>
                <strong>Asistencia SENCE Activa</strong><br>
                <small class="text-muted">Validada con ClaveÚnica (RUN: {{run_student}})</small>
            </div>
        </div>

        <form action="{{rce_cerrar_url}}" method="POST" class="mb-3">
            <input type="hidden" name="RutOtec" value="{{rut_otec}}">
            <input type="hidden" name="Token" value="{{token}}">
            <input type="hidden" name="CodSence" value="{{cod_sence}}">
            <input type="hidden" name="CodigoCurso" value="{{codigo_curso}}">
            <input type="hidden" name="IdSesionAlumno" value="{{id_sesion_alumno}}">
            <input type="hidden" name="IdSesionSence" value="{{id_sesion_sence}}">
            <input type="hidden" name="UrlRetoma" value="{{url_retoma}}">
            <input type="hidden" name="UrlError" value="{{url_error}}">
            <button type="submit" class="btn btn-outline-danger btn-sm w-100 py-2">
                <i class="fa fa-sign-out fa-fw me-1 mr-1"></i> Cerrar Asistencia SENCE
            </button>
        </form>
    {{/is_active}}

    {{^is_active}}
        <div class="alert alert-warning mb-3 p-2 small" role="alert">
            <i class="fa fa-exclamation-triangle me-1 mr-1 text-warning"></i>
            Debes validar tu asistencia en SENCE para registrar tus horas del curso.
        </div>

        <form action="{{rce_iniciar_url}}" method="POST" class="mb-3">
            <input type="hidden" name="RutOtec" value="{{rut_otec}}">
            <input type="hidden" name="Token" value="{{token}}">
            <input type="hidden" name="CodSence" value="{{cod_sence}}">
            <input type="hidden" name="CodigoCurso" value="{{codigo_curso}}">
            <input type="hidden" name="LineaCapacitacion" value="{{linea_capacitacion}}">
            <input type="hidden" name="RunAlumno" value="{{run_student}}">
            <input type="hidden" name="IdSesionAlumno" value="{{id_sesion_alumno}}">
            <input type="hidden" name="UrlRetoma" value="{{url_retoma}}">
            <input type="hidden" name="UrlError" value="{{url_error}}">
            <button type="submit" class="btn btn-primary btn-sm w-100 py-2 shadow-sm font-weight-bold" style="background-color: #225268; border-color: #225268;">
                <i class="fa fa-id-card fa-fw me-1 mr-1"></i> Iniciar Asistencia ClaveÚnica
            </button>
        </form>
    {{/is_active}}

    <!-- Barra de progreso de horas SENCE -->
    <div class="card bg-light border-0 p-2 mb-2">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="small font-weight-bold">Horas SENCE:</span>
            <span class="badge badge-info bg-info text-white">{{hours_connected}}h / {{hours_required}}h</span>
        </div>
        <div class="progress" style="height: 8px;">
            <div class="progress-bar bg-info" role="progressbar" style="width: {{attendance_percent}}%;" aria-valuenow="{{attendance_percent}}" aria-valuemin="0" aria-valuemax="100"></div>
        </div>
        <div class="text-right text-end mt-1">
            <small class="text-muted">{{attendance_percent}}% cumplido</small>
        </div>
    </div>

    <!-- Opciones de Profesor / Administrador -->
    {{#is_teacher}}
        <hr class="my-2">
        <div class="d-grid gap-1">
            <a href="{{report_url}}" class="btn btn-outline-dark btn-sm w-100 mb-1">
                <i class="fa fa-book fa-fw me-1 mr-1"></i> Libro de Asistencia SENCE
            </a>
            <a href="{{settings_url}}" class="btn btn-outline-secondary btn-sm w-100">
                <i class="fa fa-cog fa-fw me-1 mr-1"></i> Ajustes Curso SENCE
            </a>
        </div>
    {{/is_teacher}}

    <!-- Footer institucional Keystone Advisors -->
    <div class="text-center mt-3 pt-2 border-top" style="font-size: 0.68rem; line-height: 1.2; color: #6c757d;">
        Desarrollado de forma gratuita por<br>
        <a href="https://www.keystoneadvisors.cl" target="_blank" rel="noopener" class="fw-bold font-weight-bold text-decoration-none" style="color: #225268;">
            Keystone Advisors
        </a><br>
        Av. Apoquindo 6410, Of. 605, Santiago
    </div>
</div>
